  },
  {
   "escena": "cobre",
   "inicio": 22.708,
   "fin": 24.436,
   "texto": "El precio está por las nubes…",
   "cue": "precio"
  },
  {
   "escena": "cobre",
   "inicio": 24.536,
   "fin": 28.013,
   "texto": "pero en agosto, las minas produjeron 17% menos.",
   "cue": "cantidad"
  },
  {
   "escena": "cobre",
   "inicio": 28.113,
   "fin": 29.969,
   "texto": "Y eso frenó a toda la economía.",
   "cue": "total"
  },
  {
   "escena": "inflacion",
   "inicio": 30.219,
   "fin": 34.827,
   "texto": "Segundo tema: la inflación, lo que pierde tu plata cada año. La meta: 3%.",
   "cue": "meta"
  },
  {
   "escena": "inflacion",
   "inicio": 34.927,
   "fin": 36.655,
   "texto": "Partimos el año bajo la meta,",
