 "frases": [
  {
   "escena": "gancho",
   "inicio": 0.25,
   "fin": 2.853,
   "texto": "El cobre está en el precio más alto de su historia.",
   "cue": "cobre"
  },
  {
   "escena": "gancho",
   "inicio": 3.153,
   "fin": 5.499,
   "texto": "Y aun así, Chile casi no va a crecer este año.",
   "cue": "pib"
  },
  {
   "escena": "gancho",
   "inicio": 5.799,
   "fin": 7.293,
   "texto": "¿Cómo se explica eso?",
   "cue": "pregunta"
  },
  {
   "escena": "titulo",
   "inicio": 7.543,
   "fin": 8.673,
   "texto": "Vamos por partes.",
   "cue": null
  },
  {
   "escena": "crecimiento",
   "inicio": 8.923,
   "fin": 12.657,
   "texto": "Partamos por el PIB: todo lo que produce el país. El tamaño de la torta.",
   "cue": "definicion"
  },
  {
   "escena": "crecimiento",
   "inicio": 12.757,
   "fin": 15.466,
   "texto": "El año pasado creció 2,5%.",
   "cue": "barras"
  },
  {
   "escena": "crecimiento",
   "inicio": 15.566,
   "fin": 18.105,
   "texto": "Este año, el Banco Central espera menos de 1%.",
