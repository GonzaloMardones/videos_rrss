  },
  {
   "escena": "deuda",
   "inicio": 93.414,
   "fin": 97.595,
   "texto": "Por eso la regla de oro: gastos permanentes, con ingresos permanentes.",
   "cue": "regla"
  },
  {
   "escena": "futuro",
   "inicio": 97.845,
   "fin": 100.277,
   "texto": "La apuesta para salir de esto es la inversión.",
   "cue": "apuesta"
  },
  {
   "escena": "futuro",
   "inicio": 100.377,
   "fin": 105.903,
   "texto": "Con la nueva Ley de Reconstrucción, el Banco Central espera crecer entre 2% y 3% el próximo año.",
   "cue": "rebote"
  },
  {
   "escena": "tu",
   "inicio": 106.153,
   "fin": 108.201,
   "texto": "¿Y a ti, cómo te afecta todo esto?",
